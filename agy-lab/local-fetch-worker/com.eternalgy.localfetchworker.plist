<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the Mac mini's Local Fetch Worker. Install it with the sed
  line in README.md — launchd does not expand ~, so __HOME__ and __NODE__ must
  be real paths before this file is loaded. __NODE__ must be Node 24 or newer:
  worker.ts is run as TypeScript, with no build step.

  KeepAlive is unconditional, like the Maps and Step 2 workers: this should be
  running whenever the mini is up. With Crawl4AI down the worker stops claiming
  and asks again every 15s, which costs nothing and is what makes the hub notice
  within 90s that page reads are unavailable. ThrottleInterval keeps a
  crash-on-boot from becoming a spin.

  THIS DOES NOT START CRAWL4AI. The container is `--restart unless-stopped`
  under Colima, and Colima itself is started by com.eternalgy.colima.plist
  (README.md). Keeping the two apart is deliberate: the worker going quiet when
  the container is missing is the signal the hub reads.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eternalgy.localfetchworker</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/automation-tools/agy-lab/local-fetch-worker/worker.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/automation-tools/agy-lab/local-fetch-worker</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.local-fetch-worker/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local-fetch-worker/launchd.log</string>

  <!--
    No LAB_TOKEN and no CRAWL4AI_TOKEN here. A plist is world-readable; the lab
    token is a root shell on the hub container. worker.ts reads both from
    ~/.local-fetch-worker/worker.env, which is chmod 600. The worker's own log
    is ~/.local-fetch-worker/worker.log.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
